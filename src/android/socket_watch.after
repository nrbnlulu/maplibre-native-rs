void RunLoop::addWatch(int fd, Event event, std::function<void(int, Event)>&& cb) {
    MBGL_VERIFY_THREAD(tid);

    impl->readPoll[fd] = std::move(cb);
    int events = 0;
    if (event == Event::Read || event == Event::ReadWrite) events |= ALOOPER_EVENT_INPUT;
    if (event == Event::Write || event == Event::ReadWrite) events |= ALOOPER_EVENT_OUTPUT;
    ALooper_addFd(ALooper_forThread(), fd, ALOOPER_POLL_CALLBACK, events,
                  looperCallbackReadEvent, impl.get());
}
